# Skill Issue — Environment Configuration Example
# Copy this file to .env for local development

ENVIRONMENT=development
DEBUG=true

# JWT signing secret (use a secure random string in production)
SECRET_KEY=skillissue-dev-insecure-secret-key-32chars-min!

# 32-byte Fernet base64 key for encrypting stored BYOC credentials
# Generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gH7_mK9_sP2_wL4_xR8_yT1_bV3_nQ6_zC5_dF0_jA=

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillissue
POSTGRES_PORT=5433

# App database connection strings (async for FastAPI, sync for Alembic migrations)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/skillissue
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/skillissue

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# LLM inference default mode: 'bedrock' (AWS live BYOC)
DEFAULT_PROVIDER=bedrock

# Sandbox Execution Mode: 'isolated_process' (local host sandbox) or 'docker' (containerized)
SANDBOX_EXECUTION_MODE=isolated_process

# Codeforces API Credentials (Optional)
CF_API_KEY=
CF_API_SECRET=
